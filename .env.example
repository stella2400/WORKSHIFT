# Database
DATABASE_URL=postgresql+psycopg://workshift:workshift@db:5432/workshift

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_EXPIRE_MINUTES=10080

# URLs
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File uploads
UPLOADS_DIR=/app/uploads

# Registration
REGISTRATION_OPEN=true
ADMIN_REGISTRATION_TOKEN=change-this-secret-admin-token

# Email SMTP (opzionale - per notifiche)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Hugging Face - per import immagini AI
# Ottieni un token gratuito su: https://huggingface.co/settings/tokens
# Crea token con tipo "read" - nessun abbonamento richiesto
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# DB credentials (per docker-compose)
POSTGRES_DB=workshift
POSTGRES_USER=workshift
POSTGRES_PASSWORD=workshift
